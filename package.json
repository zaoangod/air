{
    "name": "@ai-zen/air",
    "version": "0.3.3",
    "description": "Minimalist AI CLI assistant — one shell tool, filesystem memory, auto context migration",
    "type": "module",
    "main": "./dist/agent-runtime.js",
    "bin": {
        "air": "dist/cli.js"
    },
    "scripts": {
        "start": "npm run build && node --env-file-if-exists=.env.local ./dist/cli.js",
        "build": "tsc",
        "prepublishOnly": "node scripts/check-publish-tool.mjs && npm run build",
        "test": "vitest run",
        "test:watch": "vitest",
        "clean": "rimraf dist",
        "prebuild": "pnpm run clean",
        "check:version": "pnpm outdated",
        "update:latest": "pnpm update --latest"
    },
    "dependencies": {
        "@ai-sdk/deepseek": "3.0.88",
        "ai": "7.0.177",
        "chalk": "6.0.1",
        "commander": "15.1.0",
        "inquirer": "14.3.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "vitest": "5.1.1"
    },
    "keywords": [
        "ai",
        "cli",
        "assistant",
        "shell",
        "deepseek",
        "terminal",
        "command-line"
    ]
}
